{
  "name": "oauth2-oidc-flow-companion",
  "displayName": "OAuth2/OIDC Flow Companion",
  "description": "Builds and decodes OAuth2 authorization-code+PKCE URLs -- generates code_verifier/challenge, assembles the auth URL, decodes an ID token. No data leaves your editor.",
  "version": "0.1.0",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "oauth2",    "oidc",    "pkce",    "auth"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-oauth2-oidc-flow-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-oauth2-oidc-flow-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "oauth2OidcFlowCompanion.open",
        "title": "OAuth2/OIDC Flow Companion: Open"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
